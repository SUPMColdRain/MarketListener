{
  "schema_version": 1,
  "strategy_id": "volume_confirm_breakout",
  "strategy_version": "1.1.0",
  "description": "收盘价创近 N 日新高且成交量超过均量的观察信号",
  "inputs": ["close", "volume"],
  "parameters": {
    "lookback": {"type": "integer", "minimum": 2, "maximum": 120, "default": 20},
    "volume_multiple": {"type": "number", "minimum": 1.0, "maximum": 10.0, "default": 1.5}
  },
  "nodes": {
    "close_series": {"type": "series", "input": "close"},
    "volume_series": {"type": "series", "input": "volume"},
    "close_max": {"type": "rolling_max", "operand": "close_series", "window": "lookback_param"},
    "volume_sma": {"type": "sma", "operand": "volume_series", "window": "lookback_param"},
    "volume_target": {"type": "multiply", "left": "volume_sma", "right": "volume_multiple_param"},
    "price_breakout": {"type": "gte", "left": "close_series", "right": "close_max"},
    "volume_confirm": {"type": "gt", "left": "volume_series", "right": "volume_target"},
    "signal_node": {"type": "and", "left": "price_breakout", "right": "volume_confirm"},
    "lookback_param": {"type": "parameter", "name": "lookback"},
    "volume_multiple_param": {"type": "parameter", "name": "volume_multiple"}
  },
  "signal": {
    "node": "signal_node",
    "label": "放量突破观察",
    "reason": "收盘价达到近 N 日最高且成交量高于均量阈值",
    "risk_tags": ["突破失败", "假突破", "追高风险"]
  }
}
