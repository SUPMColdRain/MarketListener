{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketlistener.local/contracts/strategy-result.schema.json",
  "title": "Strategy result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "strategy_id", "strategy_version", "parameter_version", "data_version", "instrument_key", "signal_time", "trigger_condition", "observation_reason", "risk_tags", "run_status"],
  "properties": {
    "schema_version": {"const": 1},
    "strategy_id": {"type": "string", "minLength": 1},
    "strategy_version": {"type": "string", "minLength": 1},
    "parameter_version": {"type": "string", "minLength": 1},
    "data_version": {"type": "string", "minLength": 1},
    "instrument_key": {"$ref": "#/$defs/instrumentKey"},
    "signal_time": {"type": "string", "format": "date-time"},
    "trigger_condition": {"type": "string", "minLength": 1},
    "observation_reason": {"type": "string", "minLength": 1},
    "risk_tags": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "run_status": {"enum": ["PASS", "FAILED", "CANCELLED", "TIMEOUT"]}
  },
  "$defs": {
    "instrumentKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country_or_market", "exchange", "asset_type", "code"],
      "properties": {
        "country_or_market": {"type": "string", "pattern": "^[A-Z]{2,12}$"},
        "exchange": {"type": "string", "pattern": "^[A-Z0-9_-]{2,16}$"},
        "asset_type": {"enum": ["STOCK", "INDEX", "FUTURE", "OPTION", "FUND", "ETF", "BOND", "COMMODITY", "CRYPTO"]},
        "code": {"type": "string", "pattern": "^[A-Z0-9._-]+$"}
      }
    }
  }
}
