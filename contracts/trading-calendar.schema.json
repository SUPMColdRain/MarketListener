{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketlistener.local/contracts/trading-calendar.schema.json",
  "title": "Trading calendar day",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "market", "calendar_date", "is_trading_day", "source"],
  "properties": {
    "schema_version": {"const": 1},
    "market": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "calendar_date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "is_trading_day": {"type": "boolean"},
    "session_kind": {"enum": ["FULL", "MORNING_ONLY", "NIGHT_ONLY", "HALF_DAY", "NONE"]},
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end"],
        "properties": {
          "start": {"type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$"},
          "end": {"type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$"}
        }
      }
    },
    "remark": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "retrieved_at"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "retrieved_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
