{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketlistener.local/contracts/market-package-manifest.schema.json",
  "title": "Market package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["package_id", "schema_version", "generated_at", "partitions", "source_run_summaries", "minimum_app_version"],
  "allOf": [
    {
      "if": {"required": ["package_type"], "properties": {"package_type": {"const": "DELTA"}}},
      "then": {"required": ["base_package_id"]}
    }
  ],
  "properties": {
    "package_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "package_type": {"enum": ["FULL", "DELTA"]},
    "base_package_id": {"type": "string", "minLength": 1},
    "minimum_app_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "partitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["partition_id", "data_cutoff", "files"],
        "properties": {
          "partition_id": {"type": "string", "minLength": 1},
          "data_cutoff": {"type": "string", "format": "date-time"},
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "bytes", "row_count", "sha256"],
              "properties": {
                "name": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
                "bytes": {"type": "integer", "minimum": 1},
                "row_count": {"type": "integer", "minimum": 0},
                "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
              }
            }
          }
        }
      }
    },
    "source_run_summaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "provider", "status"],
        "properties": {
          "run_id": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAILED", "PARTIAL_FAILURE", "BLOCKED", "UNSUPPORTED"]}
        }
      }
    }
  }
}
