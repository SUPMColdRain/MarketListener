{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketlistener.local/contracts/strategy-package-manifest.schema.json",
  "title": "Strategy package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["package_id", "schema_version", "strategy_id", "strategy_version", "entrypoint", "parameter_schema", "test_vectors_sha256", "minimum_app_version"],
  "properties": {
    "package_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": 1},
    "strategy_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,63}$"},
    "strategy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "entrypoint": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.:]*$"},
    "parameter_schema": {"type": "object"},
    "test_vectors_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "minimum_app_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "signature": {"type": "string", "minLength": 1}
  }
}
