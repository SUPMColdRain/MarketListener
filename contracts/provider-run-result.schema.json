{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketlistener.local/contracts/provider-run-result.schema.json",
  "title": "Provider run result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "provider", "status", "started_at", "completed_at", "capabilities"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "FAILED", "UNSUPPORTED"]},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAILED", "UNSUPPORTED"]},
          "detail": {"type": "string"},
          "row_count": {"type": "integer", "minimum": 0},
          "earliest": {"type": "string", "format": "date-time"},
          "latest": {"type": "string", "format": "date-time"}
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "message"],
      "properties": {
        "category": {"enum": ["AUTH", "NETWORK", "RATE_LIMIT", "PROVIDER", "NO_COVERAGE", "CONFIGURATION", "UNKNOWN"]},
        "message": {"type": "string", "minLength": 1}
      }
    }
  }
}
