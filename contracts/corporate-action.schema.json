{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketlistener.local/contracts/corporate-action.schema.json",
  "title": "Corporate action",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "instrument_key", "action_type", "ex_date", "source"],
  "properties": {
    "schema_version": {"const": 1},
    "instrument_key": {"$ref": "#/$defs/instrumentKey"},
    "action_type": {
      "enum": ["CASH_DIVIDEND", "STOCK_DIVIDEND", "SPLIT", "RIGHTS_ISSUE"]
    },
    "ex_date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "record_date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "pay_date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "cash_per_share": {"type": "number", "minimum": 0},
    "bonus_ratio": {"type": "number", "minimum": 0},
    "split_ratio": {"type": "number", "exclusiveMinimum": 0},
    "rights_ratio": {"type": "number", "minimum": 0},
    "rights_price": {"type": "number", "exclusiveMinimum": 0},
    "description": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "source_symbol", "retrieved_at"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "source_symbol": {"type": "string", "minLength": 1},
        "retrieved_at": {"type": "string", "format": "date-time"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"action_type": {"const": "CASH_DIVIDEND"}}},
      "then": {"required": ["cash_per_share"]}
    },
    {
      "if": {"properties": {"action_type": {"const": "STOCK_DIVIDEND"}}},
      "then": {"required": ["bonus_ratio"]}
    },
    {
      "if": {"properties": {"action_type": {"const": "SPLIT"}}},
      "then": {"required": ["split_ratio"]}
    },
    {
      "if": {"properties": {"action_type": {"const": "RIGHTS_ISSUE"}}},
      "then": {"required": ["rights_ratio", "rights_price"]}
    }
  ],
  "$defs": {
    "instrumentKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country_or_market", "exchange", "asset_type", "code"],
      "properties": {
        "country_or_market": {"type": "string", "pattern": "^[A-Z]{2,12}$"},
        "exchange": {"type": "string", "pattern": "^[A-Z0-9_-]{2,16}$"},
        "asset_type": {"enum": ["STOCK", "INDEX", "FUTURE", "OPTION", "FUND", "ETF", "BOND", "COMMODITY", "CRYPTO"]},
        "code": {"type": "string", "pattern": "^[A-Z0-9._-]+$"}
      }
    }
  }
}
