{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketlistener.local/contracts/industry-graph-relationship.schema.json",
  "title": "Industry graph relationship",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "relationship_id", "relationship_type", "source_entity_id", "target_entity_id", "direction", "confidence", "confirmation_status"],
  "properties": {
    "schema_version": {"const": 1},
    "relationship_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{2,63}$"},
    "relationship_type": {
      "enum": ["SUPPLIES", "PURCHASES", "PRODUCES", "PART_OF", "COMPETES_WITH", "DISTRIBUTES", "USES", "OWNS", "CUSTOMER_OF"]
    },
    "source_entity_id": {"type": "string", "minLength": 1},
    "target_entity_id": {"type": "string", "minLength": 1},
    "direction": {"enum": ["DIRECTED", "UNDIRECTED"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "confirmation_status": {"enum": ["PENDING", "AUTO_ACCEPTED", "HUMAN_CONFIRMED", "REJECTED", "SUPERSEDED"]},
    "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
